# --- secrets & local config -------------------------------------------------
.env
.env.*
!.env.example
secrets/*
!secrets/.gitkeep

# --- python -----------------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
