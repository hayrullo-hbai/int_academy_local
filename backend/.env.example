# Core
APP_NAME=Academy Platform
ENVIRONMENT=development
SECRET_KEY=dev-secret-key-change-in-production
CORS_ORIGINS=*

# Database (compose provides these to the postgres service too)
DATABASE_URL=postgresql://academy:academy@db:5432/academy_db
POSTGRES_USER=academy
POSTGRES_PASSWORD=academy
POSTGRES_DB=academy_db

# Host ports published by docker-compose.yml. Kept consistent across every
# environment (s1 and local dev) so nothing here has to change between them.
BACKEND_PORT=9999
POSTGRES_PORT=9998

# Seed admin
ADMIN_EMAIL=admin@academy.local
ADMIN_PASSWORD=admin12345

# hstaff integration
HSTAFF_BASE_URL=https://api-hstaff.humblebee.ai
HSTAFF_API_PREFIX=/api/v1
HSTAFF_ENABLED=true

# Route that returns a student's assigned mentor (profile review routing).
# Placeholders: {username}, {email}, {user_id}. Empty = disabled.
# HSTAFF_MENTOR_PATH=/talent/{username}/mentor

# Route that returns a user's mentees. On every login, anyone hstaff reports as
# having mentees is auto-granted the local "mentor" role (as a regular role, not
# primary) and their mentees' emails are mirrored locally. Empty = disabled.
# HSTAFF_MENTEES_PATH=/talent/{username}/mentees

# Onboarding Google Sheet
# ONBOARDING_SHEET_ID=
# ONBOARDING_SHEET_GID=
# GOOGLE_SERVICE_ACCOUNT_FILE=/app/secrets/gsheet-service-account.json

# Academy: Judge0 (self-hosted) — problems + exam code questions + playground run
# Points at the dependencies stack (int-academy-platform-dependencies) running
# on the same host, using its JUDGE0_PORT. JUDGE0_AUTH_TOKEN must equal
# AUTHN_TOKEN (== AUTHZ_TOKEN) in that stack's judge0/judge0.conf.
JUDGE0_URL=http://host.docker.internal:9996
JUDGE0_AUTH_TOKEN=
JUDGE0_AUTH_HEADER=X-Auth-Token

# Academy: ml-runner (self-hosted) — Data Lab pandas/sklearn/matplotlib execution
# Points at the same dependencies stack's ML_RUNNER_PORT.
MLRUNNER_URL=http://host.docker.internal:9995/run
MLRUNNER_TIMEOUT=140

# Academy: cv-generator (self-hosted) — CV HTML rendering
CV_GENERATOR_URL=http://cv-generator:8080
